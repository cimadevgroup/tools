#!/bin/bash
# pre-commit de CAMPOS (copia de tools/field-rules/hooks/pre-commit; no editar aquí: sync.sh lo reescribe).
# 1) copias de FieldRules/FieldFormat y bloque CAMPOS de CLAUDE.md al día  2) lint de inputs estándar en lo que se commitea.
TOP="$(git rev-parse --show-toplevel)"
COMMON="$(cd "$(git rev-parse --git-common-dir)" && pwd)"; REPO="$(basename "$(dirname "$COMMON")")"   # nombre del repo aun desde un worktree
DEV="${FR_DEV:-$(cd "$COMMON/../../.." 2>/dev/null && pwd)}"
FR="$DEV/modular-mango/tools/field-rules"
if [ ! -x "$FR/sync.sh" ]; then echo "campos: no encuentro $FR (¿otra máquina?). Check omitido." >&2; exit 0; fi
"$FR/sync.sh" --check --repo "$REPO" | grep -v '^OK' >&2; rc=${PIPESTATUS[0]}
[ "$rc" = 0 ] || { echo "campos: commit bloqueado. Corre $FR/sync.sh y vuelve a commitear." >&2; exit 1; }
node "$FR/lint-campos.mjs" --repo "$TOP" --staged || { echo "campos: commit bloqueado por lint-campos." >&2; exit 1; }
exit 0
