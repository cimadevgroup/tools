#!/bin/bash
# pre-commit de CAMPOS (copia de tools/field-rules/hooks/pre-commit; no editar aquí: sync.sh lo reescribe).
# 1) copias de FieldRules/FieldFormat y bloque CAMPOS de CLAUDE.md al día  2) lint de inputs estándar en lo que se commitea.
# Compara contra ESTE árbol de trabajo (checkout o worktree), no contra el checkout principal.
# Por ahora solo AVISA; bloquea con CAMPOS_ESTRICTO=1 (se vuelve bloqueante repo por repo cuando sus copias estén sincronizadas y probadas).
TOP="$(git rev-parse --show-toplevel)"
COMMON="$(cd "$(git rev-parse --git-common-dir)" && pwd)"; REPO="$(basename "$(dirname "$COMMON")")"   # nombre del repo aun desde un worktree
DEV="${FR_DEV:-$(cd "$COMMON/../../.." 2>/dev/null && pwd)}"
FR="$DEV/modular-mango/tools/field-rules"
if [ ! -x "$FR/sync.sh" ]; then echo "campos: no encuentro $FR (¿otra máquina?). Check omitido." >&2; exit 0; fi
fail=0
out="$("$FR/sync.sh" --check --repo "$REPO" --dir "$TOP" | grep -v '^OK')"; [ "${PIPESTATUS[0]}" = 0 ] || { echo "$out" >&2; fail=1; }
node "$FR/lint-campos.mjs" --repo "$TOP" --staged >&2 || fail=1
if [ "$fail" != 0 ]; then
  if [ "${CAMPOS_ESTRICTO:-}" = 1 ]; then echo "campos: commit bloqueado. Corre $FR/sync.sh y vuelve a commitear." >&2; exit 1; fi
  echo "AVISO campos: hay diferencias (el commit sigue; CAMPOS_ESTRICTO=1 lo bloquearía)." >&2
fi
exit 0
